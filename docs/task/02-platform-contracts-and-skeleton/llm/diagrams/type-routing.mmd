    TY --> EM["TEXT_EMBEDDING"]
    TY --> RR["RERANK"]
    TY --> AS["SPEECH2TEXT"]
    TY --> MO["MODERATION"]
    TY --> TT["TTS"]
    LL --> MATCH["匹配 AIModelEntity / 特性 / 参数 / 权限"]
    EM --> MATCH
    RR --> MATCH
    AS --> MATCH
    MO --> MATCH
    TT --> MATCH
    CAT --> MATCH
    MATCH --> OK["PreparedCall：固定具体模型和适配器"]
    MATCH --> NO["能力缺失或未配置：明确拒绝"]
